# ---------------------------------------------------------------------------
# Johnnybits — environment variables. Copy to .env.local and fill in.
# Never commit real values. Vercel: Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Database (Neon Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
# Direct (non-pooled) URL, used by migrations. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=require

# Admin auth. Required; at least 16 characters (32+ recommended): openssl rand -base64 32
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Site
NEXT_PUBLIC_SITE_URL=https://johnnybits.com

# Email (contact form / newsletter)
BREVO_SMTP_PASS=

# Featured image uploads from the blog admin (Vercel Blob read-write token)
# Vercel Blob. Connecting a store to the project (Storage → store → Connect Project) adds BLOB_STORE_ID; Vercel
# then authenticates with OIDC automatically. Older stores, or local use, need BLOB_READ_WRITE_TOKEN instead.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Blog agent
# ---------------------------------------------------------------------------
# lexical = Postgres full-text search, free, no key (default)
# hybrid  = lexical + vector search; needs an embeddings provider below
RETRIEVAL_MODE=lexical
# none | openai | voyage | fixture (offline, for testing)
EMBEDDINGS_PROVIDER=none
# Optional overrides. OpenAI default: text-embedding-3-small / 1536. Voyage default: voyage-3.5 / 1024 (256|512|1024|2048).
EMBEDDINGS_MODEL=
EMBEDDINGS_DIMS=
# Optional: USD per million tokens, for cost reporting.
EMBEDDINGS_USD_PER_MTOK=
OPENAI_API_KEY=
VOYAGE_API_KEY=
# Hard cap on embedding spend per pipeline run (USD). Past it the run continues keyword-only; backfill embeds later.
AGENT_MAX_EMBEDDING_USD_PER_RUN=0.5
# true = no paid calls; embeddings use the offline fixture provider
AGENT_DRY_RUN=false
# true = include FAQPage structured data on articles with an FAQ
AGENT_FAQ_SCHEMA=false

# ---------------------------------------------------------------------------
# MCP connector (OAuth 2.1 authorization server built into this app)
# ---------------------------------------------------------------------------
# Public origin of the site. Defaults to NEXT_PUBLIC_SITE_URL. Local testing: http://localhost:3000
OAUTH_ISSUER=
# Hosts allowed to identify themselves with a Client ID Metadata Document (comma-separated)
OAUTH_ALLOWED_CLIENT_HOSTS=claude.ai,claude.com
# Optional fixed bearer token (min 32 chars) for organisations with Claude's "request headers" beta. Leave empty to use OAuth only.
MCP_STATIC_TOKEN=
# Tool calls per minute per connection
MCP_RATE_LIMIT_PER_MIN=120

# ---------------------------------------------------------------------------
# Featured-image generation (optional; free tier). Cloudflare dashboard → Workers AI → "Use REST API":
# copy the Account ID and create an API token with the "Workers AI" permission. Leave both empty for upload only.
# ---------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
# Generated images allowed per 24 hours (protects the free daily allowance)
IMAGE_GEN_DAILY_LIMIT=20
# Stock-photo fallback on the review page. Set one (Pexels is used if both are set). Empty = no stock search.
# Pixabay: free key on https://pixabay.com/api/docs/ when logged in. Pexels: https://www.pexels.com/api/
PIXABAY_API_KEY=
PEXELS_API_KEY=

# ---------------------------------------------------------------------------
# Daily maintenance (vercel.json cron → /api/cron/maintenance)
# ---------------------------------------------------------------------------
# Random, 32+ chars (openssl rand -base64 32). Vercel Cron sends it as a bearer token. Unset = the route refuses.
CRON_SECRET=
